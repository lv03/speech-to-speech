+
+test('truncates document content to at most 64 KiB without corrupting UTF-8', async () => {
+  const content = '你'.repeat(30_000)
+  await withProxy({
+    service: service({
+      getDocument: async (handle) => ({
+        handle,
+        collectionName: 'Notes',
+        relativeFile: 'safe.md',
+        title: 'Safe',
