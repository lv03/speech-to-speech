# experiments/voicemem — example environment
#
# Copy to your shell (or `set -a; . experiments/voicemem/config.example.env; set +a`)
# before running zh_smoke.py in the dedicated voicemem venv. Never commit real keys.

# ── fact extraction: OpenAI-compatible chat (mandatory in voicemem 0.2.3) ────
# Without a key voicemem raises ValueError and memory stays disabled.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ── local embedding leg (no network) ────────────────────────────────────────
# voicemem's config supports embedding.provider=local (intfloat/multilingual-e5-small).
# HF_ENDPOINT is only needed when the model has to be downloaded behind a mirror.
HF_ENDPOINT=https://hf-mirror.com

# ── storage: must be app-private, never the checkout ────────────────────────
VOICEMEM_MEMORY_ROOT=/tmp/voicemem-smoke
VOICEMEM_MEMORYSPACE_ROOT=/tmp/voicemem-smoke

# ── privacy switches ────────────────────────────────────────────────────────
# mem0 defaults telemetry to true and posts to us.i.posthog.com; the adapter
# refuses to run when this is truthy.
MEM0_TELEMETRY=false
# Keep third-party log noise out of smoke output.
VOICEMEM_VERBOSE=0
