# experiments/voicemem — example environment
#
# Copy to your shell (or `set -a; . experiments/voicemem/config.example.env; set +a`)
# before running zh_smoke.py in the dedicated voicemem venv. Never commit real keys.

# ── fact extraction: OpenAI-compatible chat (mandatory) ─────────────────────
# Without a key voicemem raises ValueError and memory stays disabled.
# On voicemem main the role-based names work too and win over the legacy ones:
#   VOICEMEM_CHAT_MODEL / VOICEMEM_REPLY_MODEL / VOICEMEM_EMBEDDING_MODEL /
#   VOICEMEM_TTS_MODEL / VOICEMEM_REALTIME_MODEL
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Stored memory text language. main defaults to "en"; without this the Chinese
# facts come back as "User lives in Taipei" and retrieval quality drops.
VOICEMEM_MEMORY_LANGUAGE=zh

# ── local embedding leg (no network after the first download) ───────────────
# voicemem's config supports embedding.provider=local (intfloat/multilingual-e5-small).
# HF_ENDPOINT must point at a host that actually resolves from your network:
# on 2026-09-08 hf-mirror.com did not resolve here while huggingface.co did.
# Set HF_HUB_OFFLINE=1 once E5 is cached; otherwise flaky HEAD requests add
# ~10 s retries to every start.
HF_ENDPOINT=https://huggingface.co
HF_HUB_OFFLINE=1

# ── storage: must be app-private, never the checkout ────────────────────────
VOICEMEM_MEMORY_ROOT=/tmp/voicemem-smoke
VOICEMEM_MEMORYSPACE_ROOT=/tmp/voicemem-smoke

# ── privacy switches ────────────────────────────────────────────────────────
# mem0 defaults telemetry to true and posts to us.i.posthog.com; the adapter
# refuses to run when this is truthy.
MEM0_TELEMETRY=false
# Keep third-party log noise out of smoke output.
VOICEMEM_VERBOSE=0
